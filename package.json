{
  "name": "signalk-opencpn",
  "version": "0.1.1",
  "description": "Run OpenCPN in a container and use it from any browser on the boat",
  "main": "plugin/index.js",
  "type": "module",
  "signalk-plugin-enabled-by-default": true,
  "scripts": {
    "build": "tsc && npm run typecheck:panel && node build.js && vite build",
    "typecheck:panel": "tsc -p src/configpanel --noEmit",
    "build:all": "npm run lint && npm run check:paths && npm run build && npm run test",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.ts' 'src/**/*.tsx' 'test/**/*.ts'",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.tsx\" \"test/**/*.ts\" && eslint --fix 'src/**/*.ts' 'src/**/*.tsx' 'test/**/*.ts' && npm run format:other",
    "format:other": "prettier --write \"**/*.md\" \"*.{json,yml,yaml,mjs,js}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"src/**/*.tsx\" \"test/**/*.ts\" \"**/*.md\" \"*.{json,yml,yaml,mjs,js}\" \".github/**/*.{yml,yaml}\"",
    "prepublishOnly": "npm run build",
    "release": "npm run build:all && git tag -a v$npm_package_version -m v$npm_package_version && git push --atomic origin HEAD refs/tags/v$npm_package_version",
    "check:paths": "node scripts/check-home-paths.mjs"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-plugin-configurator",
    "signalk-category-instruments",
    "opencpn",
    "chartplotter",
    "marine"
  ],
  "signalk": {
    "displayName": "OpenCPN",
    "appIcon": "icon.svg",
    "webapp": {
      "name": "OpenCPN",
      "description": "OpenCPN chart plotter in your browser",
      "location": "/plugins/signalk-opencpn/"
    },
    "requires": [
      "signalk-container"
    ],
    "recommends": [
      "signalk-charts-provider-simple"
    ]
  },
  "files": [
    "plugin/**/*",
    "public/**/*",
    "LICENSE.md",
    "CONTRIBUTING.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22",
    "signalk": ">=2.31.0"
  },
  "dependencies": {
    "signalk-container-helper": "^0.7.0",
    "typebox": "^1.3.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@module-federation/vite": "^1.20.5",
    "@signalk/server-api": "^2.31.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "express": "^5.2.1",
    "prettier": "^3.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dirkwa/signalk-opencpn.git"
  },
  "bugs": {
    "url": "https://github.com/dirkwa/signalk-opencpn/issues"
  },
  "homepage": "https://github.com/dirkwa/signalk-opencpn#readme",
  "author": "Dirk Wahrheit",
  "license": "SEE LICENSE IN LICENSE.md"
}
